# Placeholder values only. Copy this file to .env.local and fill in your own
# credentials. Real secrets belong in .env.local (gitignored), never here.
################################################################################
# WorkOS AuthKit (required for login)                                          #
################################################################################
# From https://dashboard.workos.com/get-started
WORKOS_CLIENT_ID="client_01..."
WORKOS_API_KEY="sk_test_..."
# Random 32+ character string used to encrypt the session cookie.
# Generate one with: `openssl rand -base64 32`
WORKOS_COOKIE_PASSWORD=""
# Must match a Redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

################################################################################
# Convex (optional — required for modules, quizzes, assistant data)            #
################################################################################
# Leave blank to run the platform in "Convex not configured" preview mode:
# landing + WorkOS sign-in work, but protected pages show a setup screen
# instead of the dashboard until you provision Convex.
#
# Once you run `npx convex dev`, this is populated automatically.
NEXT_PUBLIC_CONVEX_URL=""
# Inside the Convex deployment (set with `npx convex env set ...`) you also need:
#   WORKOS_CLIENT_ID   — same value as below, used by convex/auth.config.ts
#   AI_GATEWAY_API_KEY — used by the embeddings action (see below)

################################################################################
# Vercel AI Gateway (required for the AI assistant)                            #
################################################################################
# One key, every model. Get it at https://vercel.com/dashboard → AI → Gateway.
AI_GATEWAY_API_KEY=""

# Model the Mastra training assistant runs on. Any model exposed by AI Gateway
# works — swap providers without changing code (e.g. anthropic/claude-sonnet-4-6,
# google/gemini-2.5-flash). Prefix with `vercel/` to route through the gateway.
MASTRA_AGENT_MODEL="vercel/openai/gpt-4.1-mini"

# Embedding model used by the Convex retrieval action to index lesson chunks.
# Sent to the AI Gateway's OpenAI-compatible /v1/embeddings endpoint.
EMBEDDING_MODEL="openai/text-embedding-3-small"
